# ── Almacenamiento (Cloudflare R2) ────────────────────────────────────────
# Instagram y TikTok DESCARGAN las imágenes desde una URL pública.
# CDN_BASE_URL debe ser un dominio tuyo: TikTok exige verificar la propiedad
# y no puedes verificar el *.r2.dev que da Cloudflare por defecto.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chinesereads-media
CDN_BASE_URL=https://cdn.chinesereads.com

# ── Instagram ─────────────────────────────────────────────────────────────
# Con "Instagram API with Instagram Login" no hace falta Página de Facebook.
# Si usas Facebook Login, cambia GRAPH_BASE a https://graph.facebook.com/v23.0
GRAPH_BASE=https://graph.instagram.com/v23.0
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── TikTok ────────────────────────────────────────────────────────────────
# draft  = va a tus borradores, publicas con un toque (NO necesita auditoría)
# direct = publica solo (necesita superar la auditoría de TikTok)
TIKTOK_MODE=draft
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# ── Contenido ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
